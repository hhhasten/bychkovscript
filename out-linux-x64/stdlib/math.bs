# Constants
const PI: float = 3.14159265359;
const TAU: float = PI * 2;
const E: float = 2.71828182846;

# Basic Utilities
fn pow(a: float, pow: int) -> float {
    if (pow === 0) { 
        return 1;
    }

    let result: float = a;

    for i in 0..pow-1 {
        result = result * a;
    }
    
    return result;
}

fn abs(a: float) -> float {
    if (a < 0.0) { 
        return 0.0 - a; 
    }
    return a;
}

fn absInt(a: int) -> int {
    if (a < 0) { 
        return 0 - a; 
    }
    return a;
}

fn min(a: float, b: float) -> float {
    if (a < b) { 
        return a; 
    }
    return b;
}

fn max(a: float, b: float) -> float {
    if (a > b) { 
        return a; 
    }
    return b;
}

fn clamp(val: float, minVal: float, maxVal: float) -> float {
    if (val < minVal) { 
        return minVal; 
    }
    if (val > maxVal) { 
        return maxVal; 
    }
    return val;
}

fn sign(a: float) -> int {
    if (a < 0.0) { 
        return 0 - 1; 
    }
    if (a > 0.0) { 
        return 1; 
    }
    return 0;
}

# Number Theory
fn fib(n: int) -> int {
    let a: int = 0;
    let b: int = 1;
    let temp: int = 0;
    
    for i in 2..n+1 {
        temp = a + b;
        a = b;
        b = temp;
    }
    
    return b;
}
fn fibRecursive(n: int) -> int {    # less efficient version for educational purposes
    if (n <= 1) {
        return n;
    }
    return fibRecursive(n - 1) + fibRecursive(n - 2);
}

fn factorial(n: int) -> int {
    if (n <= 1) { 
        return 1; 
    }
    let res: int = 1;
    for i in 1..n+1 {
        res = res * i;
    }
    return res;
}

# Advanced Approximations
fn sqrt(x: float) -> float {
    if (x <= 0.0) { 
        return 0.0; 
    }
    
    let guess: float = x / 2.0;
    let lastGuess: float = 0.0;
    let diff: float = guess;
    
    while (diff > 0.000001) {
        lastGuess = guess;
        guess = (guess + (x / guess)) / 2.0;
        diff = abs(guess - lastGuess);
    }
    
    return guess;
}

fn exp(x: float) -> float {
    let sum: float = 1.0;
    let term: float = 1.0;
    
    for i in 1..20 {
        term = (term * x) / i;
        sum = sum + term;
    }
    return sum;
}

# Trigonometry
fn sin(x: float) -> float {
    while (x > PI) { x = x - TAU; }
    while (x < 0.0 - PI) { x = x + TAU; }

    let sum: float = 0.0;
    let term: float = x;
    let xSq: float = x * x;
    
    sum = sum + term;
    
    term = (term * xSq) / 6.0;
    sum = sum - term;
    
    term = (term * xSq) / 20.0;
    sum = sum + term;
    
    term = (term * xSq) / 42.0;
    sum = sum - term;
    
    term = (term * xSq) / 72.0;
    sum = sum + term;

    return sum;
}

fn cos(x: float) -> float {
    while (x > PI) { x = x - TAU; }
    while (x < 0.0 - PI) { x = x + TAU; }

    let sum: float = 1.0;
    let term: float = 1.0;
    let xSq: float = x * x;

    term = (term * xSq) / 2.0;
    sum = sum - term;

    term = (term * xSq) / 12.0;
    sum = sum + term;

    term = (term * xSq) / 30.0;
    sum = sum - term;

    term = (term * xSq) / 56.0;
    sum = sum + term;

    return sum;
}

fn degToRad(deg: float) -> float {
    return deg * (PI / 180.0);
}

fn radToDeg(rad: float) -> float {
    return rad * (180.0 / PI);
}